{
  "data": "config/data_batch1.json",
  "encoders": {
    "vision_patch": {
      "k": 1,
      "top_frac": 0.05,
      "bank_stride": 5
    },
    "physics_roles": {
      "k": 5,
      "metrics": [
        "std_euclidean",
        "mahalanobis"
      ]
    },
    "physics_hist": {
      "k": 5,
      "metrics": [
        "std_euclidean",
        "mahalanobis"
      ]
    },
    "semantic": {
      "k": 1,
      "metric": "cosine",
      "dedupe_reference": true
    },
    "semantic_dist": {
      "k": 5,
      "metrics": [
        "kl_mean",
        "kl_knn"
      ]
    }
  },
  "semantic_encoder_params": {
    "min_score": 0.025,
    "top_n": 5
  },
  "physics_hist_encoder_params": {
    "history": 10
  },
  "text_embedding": {
    "embedders": [
      "bert"
    ]
  },
  "output_stem": "scores_batch1",
  "calibration_cache": "conformal_calibration_batch1.npz",
  "conformal_results": "conformal_batch1.json",
  "conformal": {
    "alpha_trans": 0.05,
    "alpha_cal": 0.1
  },
  "plot": false,
  "show": false
}
